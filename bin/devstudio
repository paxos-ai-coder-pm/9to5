#!/usr/bin/env bash
# Dev Studio launcher for macOS and Linux (on Windows, Git Bash hands over to devstudio.cmd).
#   devstudio          start the office and open it in the browser (an older version still running is replaced)
#   devstudio update   get the latest version and restart the office
#   devstudio stop     stop the office (and any run it is doing)
#   devstudio status   show whether it's running
# Environment: DEVSTUDIO_PORT (default 4400), DEVSTUDIO_NO_BROWSER=1 (don't open a browser).
# The work is done by tools/team-office/launch.mjs, shared with the Windows launcher.
set -euo pipefail

case "$(uname -s)" in
  MINGW* | MSYS* | CYGWIN*) exec cmd //c "$(cygpath -w "$(dirname "$0")/devstudio.cmd")" "$@" ;;
esac

# find the studio folder, also when this script is symlinked into ~/.local/bin
src="$0"
while [ -h "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
STUDIO="$(cd -P "$(dirname "$src")/.." && pwd)"

if ! command -v node >/dev/null 2>&1; then
  echo "Node.js is needed but wasn't found. Install it from https://nodejs.org (version 20 or newer), then run devstudio again."
  exit 1
fi
exec node "$STUDIO/tools/team-office/launch.mjs" "$@"
